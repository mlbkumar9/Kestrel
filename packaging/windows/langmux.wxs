<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Kestrel" Language="1033" Version="$(var.Version)"
           Manufacturer="Kestrel" UpgradeCode="{E110F64D-5C3D-5E2D-9B02-53217F2CAEA5}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Kestrel is already installed." />
    <Upgrade Id="{bba02aaf-78ca-41e3-8586-b84b471755ed}">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Maximum="$(var.Version)" IncludeMaximum="no"
                      Property="LEGACY_V2_FOUND" OnlyDetect="no"/>
    </Upgrade>
    <Media Id="1" Cabinet="Kestrel.cab" EmbedCab="yes" />
    <Icon Id="KestrelIcon" SourceFile="$(var.StageDir)/kestrel.ico" />
    <Property Id="ARPPRODUCTICON" Value="KestrelIcon" />

    <Feature Id="ProductFeature" Title="Kestrel" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="FfmpegBinaries" />
      <ComponentRef Id="FfmpegLicense" />
      <ComponentRef Id="MkvToolnixFiles" />
      <!-- MKVTOOLNIX_DLL_REFS -->
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Kestrel">
          <Component Id="ApplicationFiles" Guid="{5a0a83fb-0598-4b63-abef-7b399d4442f8}">
            <File Id="KestrelExe" Name="kestrel.exe" Source="$(var.StageDir)/kestrel.exe" KeyPath="yes" />
            <File Id="RootLicense" Name="LICENSE" Source="$(var.StageDir)/LICENSE" />
            <File Id="Readme" Name="README.md" Source="$(var.StageDir)/README.md" />
            <File Id="ThirdPartyNotices" Name="THIRD_PARTY_NOTICES.md" Source="$(var.StageDir)/THIRD_PARTY_NOTICES.md" />
            <File Id="KestrelIconFile" Name="kestrel.ico" Source="$(var.StageDir)/kestrel.ico" />
          </Component>
          <Directory Id="ToolsFolder" Name="tools">
            <Directory Id="FfmpegFolder" Name="ffmpeg">
              <Component Id="FfmpegLicense" Guid="{83c21b28-a2eb-4e4e-9ac9-efc8063a2af1}">
                <File Id="FfmpegLicenseFile" Name="LICENSE" Source="$(var.StageDir)/tools/ffmpeg/LICENSE" KeyPath="yes" />
              </Component>
              <Directory Id="FfmpegBinFolder" Name="bin">
                <Component Id="FfmpegBinaries" Guid="{0f98422c-9148-4f56-8d8e-4e576de1af3e}">
                  <File Id="FfmpegExe" Name="ffmpeg.exe" Source="$(var.StageDir)/tools/ffmpeg/bin/ffmpeg.exe" KeyPath="yes" />
                  <File Id="FfprobeExe" Name="ffprobe.exe" Source="$(var.StageDir)/tools/ffmpeg/bin/ffprobe.exe" />
                </Component>
              </Directory>
            </Directory>
            <Directory Id="MkvToolnixFolder" Name="mkvtoolnix">
              <Component Id="MkvToolnixFiles" Guid="{50c7e8f9-9726-4b87-9d3b-696b456ff3f9}">
                <File Id="MkvmergeExe" Name="mkvmerge.exe" Source="$(var.StageDir)/tools/mkvtoolnix/mkvmerge.exe" KeyPath="yes" />
                <File Id="MkvToolnixLicense" Name="COPYING.txt" Source="$(var.StageDir)/tools/mkvtoolnix/COPYING.txt" />
              </Component>
              <!-- MKVTOOLNIX_DLLS -->
            </Directory>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuKestrelFolder" Name="Kestrel">
          <Component Id="StartMenuShortcut" Guid="{f6a5b3f5-e2ff-4bc4-ba84-e24ca4d8b7a0}">
            <Shortcut Id="KestrelStartMenuShortcut" Name="Kestrel"
                      Description="Kestrel MKV language remuxer"
                      Target="[INSTALLFOLDER]kestrel.exe" WorkingDirectory="INSTALLFOLDER"
                      Icon="KestrelIcon" IconIndex="0" />
            <RemoveFolder Id="RemoveProgramMenuKestrelFolder" On="uninstall" />
            <RegistryValue Root="HKLM" Key="Software\mlbkumar9\Kestrel"
                           Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
  </Product>
</Wix>
